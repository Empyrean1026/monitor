generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ANALYST
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  UNDISCLOSED
}

enum MemberLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAY
  KONBINI
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Customer {
  id               String      @id @default(cuid())
  name             String
  email            String      @unique
  gender           Gender      @default(UNDISCLOSED)
  age              Int?
  region           String
  memberLevel      MemberLevel @default(BRONZE)
  registrationDate DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orders           Order[]

  @@index([region])
  @@index([memberLevel])
  @@index([registrationDate])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id           String        @id @default(cuid())
  name         String
  sku          String        @unique
  categoryId   String
  price        Decimal       @db.Decimal(12, 2)
  cost         Decimal       @db.Decimal(12, 2)
  stock        Int
  reorderLevel Int           @default(10)
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItems   OrderItem[]

  @@index([categoryId, status])
  @@index([stock])
  @@index([createdAt])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerId    String
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  region        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items         OrderItem[]

  @@index([customerId])
  @@index([status, createdAt])
  @@index([region, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  costAtSale Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([orderId, productId])
  @@index([productId])
}

model TrafficRecord {
  id              String   @id @default(cuid())
  visitDate       DateTime @unique @db.Date
  pageViews       Int
  uniqueVisitors  Int
  addToCartCount  Int
  checkoutCount   Int
  orderCount      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([visitDate])
}
